# ==============================================================
# CATASTO MAP — configurazione del backend (copiare in .env)
# Nessun valore di questo file viene mai inviato al browser.
# ==============================================================

# development | production  (in development: log verbosi, MockOwnershipProvider consentito)
NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Segreto per la firma dei cookie di sessione (OBBLIGATORIO in produzione).
# Generare con:  npm run hash-password -- --secret
SESSION_SECRET=

# true dietro un reverse proxy HTTPS (nginx, Caddy, Cloudflare): abilita cookie Secure e trust proxy
BEHIND_PROXY=false
COOKIE_SECURE=false

# Origini ammesse per CORS (solo se il frontend è servito da un'altra origine). Vuoto = stessa origine.
# Es.: https://catasto.example.org,https://www.example.org
CORS_ORIGINS=

# Durata sessione (minuti)
SESSION_MINUTES=480

# --------------------------------------------------------------
# UTENTI (profilo OPERATOR / ADMIN). Password con hash scrypt:
#   npm run hash-password -- "la-mia-password"
# Formato JSON su una riga. In alternativa: file server/users.json (stesso formato, non versionato).
# --------------------------------------------------------------
USERS_JSON=[]
# USERS_JSON=[{"username":"operatore","role":"OPERATOR","passwordHash":"scrypt$...$..."},{"username":"admin","role":"ADMIN","passwordHash":"scrypt$...$..."}]

# --------------------------------------------------------------
# SERVIZI CARTOGRAFICI UFFICIALI (Agenzia delle Entrate, CC BY 4.0)
# --------------------------------------------------------------
CATASTO_WMS_URL=https://wms.cartografia.agenziaentrate.gov.it/inspire/wms/ows01.php
CATASTO_WFS_URL=https://wfs.cartografia.agenziaentrate.gov.it/inspire/wfs/owfs01.php
# Ortofoto Geoportale Nazionale (risponde solo in http: per questo viene proxata). Vuoto = proxy disattivato.
PCN_WMS_URL=http://wms.pcn.minambiente.it/ogc?map=/ms_ogc/WMS_v1.3/raster/ortofoto_colore_12.map
# Proxy WMS aggiuntivi (JSON id -> URL), es. {"regione":"https://.../geoserver/wms"}
EXTRA_WMS_PROXIES={}
# User-Agent inviato ai servizi esterni (Nominatim lo richiede: indicare un contatto reale)
UPSTREAM_USER_AGENT=CatastoMap/1.0 (contatto: admin@example.org)

# Geocoder usato lato server (ricerca inversa per Comune)
GEOCODER_URL=https://nominatim.openstreetmap.org

# --------------------------------------------------------------
# VISURE / INTESTATARI — solo tramite servizio AUTORIZZATO
#   none : (default) la funzione risponde "Visura catastale non configurata"
#   mock : SOLO con NODE_ENV=development — dati fittizi dichiarati
#   http : adattatore verso un servizio autorizzato che l'ente ha titolo a usare
#          (es. integrazione con SISTER / servizi di interoperabilità AdE tramite intermediario abilitato)
# --------------------------------------------------------------
OWNERSHIP_PROVIDER=none
OWNERSHIP_API_URL=
OWNERSHIP_API_TOKEN=
OWNERSHIP_API_TIMEOUT_MS=30000
# Richiede il campo "motivo della consultazione" prima di restituire dati personali
REQUIRE_MOTIVO=true

# --------------------------------------------------------------
# LOG
# --------------------------------------------------------------
AUDIT_LOG=server/logs/audit.log
ACCESS_LOG=server/logs/access.log
LOG_LEVEL=info
